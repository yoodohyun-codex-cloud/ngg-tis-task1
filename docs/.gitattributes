# Keep machine-generated research data accessible while collapsing large GitHub diffs.
CLOUD_RESULTS.html linguist-generated=true
cloud-results-*/** linguist-generated=true
cloud-restart-20261020/instruments/*.json linguist-generated=true
cloud-restart-20261020/backups/*.json linguist-generated=true
# Python csv.writer emits valid RFC4180 CRLF; preserve generated bytes and check whitespace accordingly.
*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
